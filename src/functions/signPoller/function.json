{
  "bindings": [
    {
      "type": "timerTrigger",
      "direction": "in",
      "name": "timer",
      "schedule": "0 */3 * * * *"
    },
    {
      "type": "queue",
      "direction": "out",
      "name": "archiveQueue",
      "queueName": "docflow-archive",
      "connection": "AzureWebJobsStorage"
    }
  ]
}
