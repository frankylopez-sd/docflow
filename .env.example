# DocFlow environment template. Copy to .env for local development.
# In Azure, every value below is an App Setting (secrets via Key Vault references).

ENVIRONMENT=local

# ---- Adobe (PDF Services + Sign) ----
ADOBE_CLIENT_ID=<client-id>
ADOBE_CLIENT_SECRET=<client-secret>
# Optional: base64-encoded JWT/credentials file (legacy JWT auth). OAuth
# server-to-server (client id + secret) is the primary auth path.
ADOBE_JWT_FILE=
# Adobe IMS token endpoint (default is fine)
ADOBE_IMS_URL=https://ims-na1.adobelogin.com
# PDF Services API base
ADOBE_PDF_SERVICES_URL=https://pdf-services.adobe.io
# Adobe Sign API base (shard-specific, e.g. na1/na4)
ADOBE_SIGN_API_URL=https://api.na1.adobesign.com
# Optional static integration key for Adobe Sign (skips OAuth refresh flow)
ADOBE_SIGN_INTEGRATION_KEY=
# Optional OAuth refresh token for Adobe Sign
ADOBE_SIGN_REFRESH_TOKEN=
# Public URL Adobe Sign calls when an agreement completes
ADOBE_WEBHOOK_URL=https://<functionapp>.azurewebsites.net/api/adobeWebhook

# ---- Monday.com ----
MONDAY_API_TOKEN=<token>
MONDAY_API_URL=https://api.monday.com/v2
MONDAY_ONBOARDING_BOARD_ID=<board-id>
MONDAY_TEMPLATE_CATALOG_ID=<board-id>
MONDAY_ARCHIVE_BOARD_ID=<board-id>
# Webhook signing secret (from the Monday webhook integration config)
MONDAY_SIGNING_SECRET=<signing-secret>

# Monday column ids on the onboarding board (no hardcoded ids in code)
MONDAY_COL_STATUS=status
MONDAY_COL_AGREEMENT_ID=text_agreement
MONDAY_COL_PDF_URL=link_pdf
MONDAY_COL_SIGNED_PDF_URL=link_signed
MONDAY_COL_SIGNER_DETAILS=long_text_signers
MONDAY_COL_TIMESTAMP=date_updated
MONDAY_COL_EMAIL=email
MONDAY_COL_START_DATE=date_start
MONDAY_COL_POSITION=text_position
MONDAY_COL_MANAGER=text_manager
MONDAY_COL_TEMPLATE=text_template
# Checkbox column that triggers the flow
MONDAY_COL_TRIGGER=checkbox

# ---- Azure Storage ----
STORAGE_ACCOUNT_NAME=docautomationstore
STORAGE_ACCOUNT_KEY=<key>
# Optional secondary account used if the primary fails
STORAGE_ACCOUNT_NAME_SECONDARY=
STORAGE_ACCOUNT_KEY_SECONDARY=
BLOB_TEMP_CONTAINER=pdf-temp
BLOB_ARCHIVE_CONTAINER=pdf-archive

# ---- SharePoint (future phase; recorded for completeness) ----
SHAREPOINT_SITE_URL=https://medwatchers.sharepoint.com/sites/HR

# ---- Observability ----
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ---- Tuning (safe defaults; override only for tests/tuning) ----
DOCFLOW_RETRY_BASE_MS=500
DOCFLOW_ADOBE_RATE_LIMIT_PER_MIN=500
DOCFLOW_MONDAY_RATE_LIMIT_PER_SEC=10
DOCFLOW_TEMP_MAX_AGE_HOURS=168
