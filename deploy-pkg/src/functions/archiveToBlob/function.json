{
  "bindings": [
    {
      "type": "queueTrigger",
      "direction": "in",
      "name": "message",
      "queueName": "docflow-archive",
      "connection": "AzureWebJobsStorage"
    },
    {
      "type": "queue",
      "direction": "out",
      "name": "poisonRetryQueue",
